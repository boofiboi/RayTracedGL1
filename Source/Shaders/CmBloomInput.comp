#version 460

#define DESC_SET_FRAMEBUFFERS 0
#define DESC_SET_GLOBAL_UNIFORM 1
#define DESC_SET_TONEMAPPING 2
#include "ShaderCommonGLSLFunc.h"
#include "Exposure.h"

layout(local_size_x = COMPUTE_BLOOM_DOWNSAMPLE_GROUP_SIZE_X, local_size_y = COMPUTE_BLOOM_DOWNSAMPLE_GROUP_SIZE_Y, local_size_z = 1) in;

vec3 getBloomInput( const vec3 hdr, const vec3 screenEmis )
{
    float evBloom = getCurrentEV100() + globalUniform.bloomEmissionMultiplier;

    vec3 bloom = ( hdr + screenEmis * ev100ToLuminance( evBloom ) ) *
                 ev100ToLuminousExposure( getCurrentEV100() );

    if( any( isnan( bloom ) ) || any( isinf( bloom ) ) )
    {
        bloom = vec3( 0 );
    }

    return bloom * smoothstep( 0,
                               globalUniform.bloomThreshold,
                               getLuminance( bloom ) );
}

vec3 sampleBloomPixel( const ivec2 pix )
{
    vec3       hdr        = texelFetch( framebufFinal_Sampler, pix, 0 ).rgb;
    const vec3 screenEmis = texelFetch( framebufScreenEmission_Sampler, pix, 0 ).rgb;

    const vec4 volumetric = texelFetch( framebufScattering_Sampler, pix, 0 );
    hdr                   = hdr * volumetric.a + volumetric.rgb;

    return getBloomInput( hdr, screenEmis );
}

void main()
{
    const ivec2 dstPix = ivec2( gl_GlobalInvocationID.xy );
    const ivec2 fullResBase = dstPix * 2;

    if( fullResBase.x >= int( globalUniform.renderWidth ) ||
        fullResBase.y >= int( globalUniform.renderHeight ) )
    {
        return;
    }

    const ivec2 maxCoord = ivec2( int( globalUniform.renderWidth ) - 1, int( globalUniform.renderHeight ) - 1 );

    const ivec2 p00 = min( fullResBase + ivec2( 0, 0 ), maxCoord );
    const ivec2 p10 = min( fullResBase + ivec2( 1, 0 ), maxCoord );
    const ivec2 p01 = min( fullResBase + ivec2( 0, 1 ), maxCoord );
    const ivec2 p11 = min( fullResBase + ivec2( 1, 1 ), maxCoord );

    const vec3 b00 = sampleBloomPixel( p00 );
    const vec3 b10 = sampleBloomPixel( p10 );
    const vec3 b01 = sampleBloomPixel( p01 );
    const vec3 b11 = sampleBloomPixel( p11 );

    const vec3 bloom = ( b00 + b10 + b01 + b11 ) * 0.25;

    imageStore( framebufBloomInput, dstPix, vec4( bloom, 0.0 ) );
}

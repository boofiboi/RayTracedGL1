#version 460

#include "EfSimple.inl"

#define hardScan     -8.0
#define hardPix      -3.0
#define warpX         0.031
#define warpY         0.041
#define maskDark      0.5
#define maskLight     1.5
#define shadowMask    3.0
#define brightBoost   1.0
#define hardBloomPix -1.5
#define hardBloomScan -2.0
#define bloomAmount   0.15
#define shape         2.0

vec3 FetchBilinear(vec2 uv)
{
    ivec2 sz = effect_getFramebufSize();
    vec2 fpos = uv * vec2(sz) - 0.5;
    ivec2 i = ivec2(floor(fpos));
    vec2 f = fpos - vec2(i);
    vec3 s00 = effect_loadFromSource(clamp(i,               ivec2(0), sz - 1));
    vec3 s10 = effect_loadFromSource(clamp(i + ivec2(1, 0), ivec2(0), sz - 1));
    vec3 s01 = effect_loadFromSource(clamp(i + ivec2(0, 1), ivec2(0), sz - 1));
    vec3 s11 = effect_loadFromSource(clamp(i + ivec2(1, 1), ivec2(0), sz - 1));
    return mix(mix(s00, s10, f.x), mix(s01, s11, f.x), f.y);
}

vec2 Warp(vec2 pos)
{
    pos = pos * 2.0 - 1.0;
    pos *= vec2(1.0 + (pos.y * pos.y) * warpX, 1.0 + (pos.x * pos.x) * warpY);
    return pos * 0.5 + 0.5;
}

float ToLinear1(float c)
{
    return (c <= 0.04045) ? c / 12.92 : pow((c + 0.055) / 1.055, 2.4);
}

vec3 ToLinear(vec3 c)
{
    return vec3(ToLinear1(c.r), ToLinear1(c.g), ToLinear1(c.b));
}

float ToSrgb1(float c)
{
    return (c < 0.0031308) ? c * 12.92 : 1.055 * pow(c, 0.41666) - 0.055;
}

vec3 ToSrgb(vec3 c)
{
    return vec3(ToSrgb1(c.r), ToSrgb1(c.g), ToSrgb1(c.b));
}

vec3 Fetch(vec2 uv, vec2 off)
{
    ivec2 sz = effect_getFramebufSize();
    vec2 d = vec2(1.0) / vec2(sz);
    uv += off * d;
    return ToLinear(brightBoost * FetchBilinear(clamp(uv, vec2(0.0), vec2(1.0))));
}

vec2 Dist(vec2 uv)
{
    ivec2 sz = effect_getFramebufSize();
    vec2 pos = uv * vec2(sz);
    return -((pos - floor(pos)) - vec2(0.5));
}

float Gaus(float pos, float scale)
{
    return exp2(scale * pow(abs(pos), shape));
}

vec3 Horz3(vec2 uv, float off)
{
    vec3 b   = Fetch(uv, vec2(-1.0, off));
    vec3 c   = Fetch(uv, vec2( 0.0, off));
    vec3 d   = Fetch(uv, vec2( 1.0, off));
    float dst = Dist(uv).x;
    float wb = Gaus(dst - 1.0, hardPix);
    float wc = Gaus(dst + 0.0, hardPix);
    float wd = Gaus(dst + 1.0, hardPix);
    return (b * wb + c * wc + d * wd) / (wb + wc + wd);
}

vec3 Horz5(vec2 uv, float off)
{
    vec3 a   = Fetch(uv, vec2(-2.0, off));
    vec3 b   = Fetch(uv, vec2(-1.0, off));
    vec3 c   = Fetch(uv, vec2( 0.0, off));
    vec3 d   = Fetch(uv, vec2( 1.0, off));
    vec3 e   = Fetch(uv, vec2( 2.0, off));
    float dst = Dist(uv).x;
    float wa = Gaus(dst - 2.0, hardPix);
    float wb = Gaus(dst - 1.0, hardPix);
    float wc = Gaus(dst + 0.0, hardPix);
    float wd = Gaus(dst + 1.0, hardPix);
    float we = Gaus(dst + 2.0, hardPix);
    return (a * wa + b * wb + c * wc + d * wd + e * we) / (wa + wb + wc + wd + we);
}

vec3 Horz7(vec2 uv, float off)
{
    vec3 a   = Fetch(uv, vec2(-3.0, off));
    vec3 b   = Fetch(uv, vec2(-2.0, off));
    vec3 c   = Fetch(uv, vec2(-1.0, off));
    vec3 d   = Fetch(uv, vec2( 0.0, off));
    vec3 e   = Fetch(uv, vec2( 1.0, off));
    vec3 f   = Fetch(uv, vec2( 2.0, off));
    vec3 g   = Fetch(uv, vec2( 3.0, off));
    float dst = Dist(uv).x;
    float wa = Gaus(dst - 3.0, hardBloomPix);
    float wb = Gaus(dst - 2.0, hardBloomPix);
    float wc = Gaus(dst - 1.0, hardBloomPix);
    float wd = Gaus(dst + 0.0, hardBloomPix);
    float we = Gaus(dst + 1.0, hardBloomPix);
    float wf = Gaus(dst + 2.0, hardBloomPix);
    float wg = Gaus(dst + 3.0, hardBloomPix);
    return (a * wa + b * wb + c * wc + d * wd + e * we + f * wf + g * wg) / (wa + wb + wc + wd + we + wf + wg);
}

float Scan(vec2 uv, float off)
{
    return Gaus(Dist(uv).y + off, hardScan);
}

float BloomScan(vec2 uv, float off)
{
    return Gaus(Dist(uv).y + off, hardBloomScan);
}

vec3 Tri(vec2 uv)
{
    vec3 a  = Horz3(uv, -1.0);
    vec3 b  = Horz5(uv,  0.0);
    vec3 c  = Horz3(uv,  1.0);
    float wa = Scan(uv, -1.0);
    float wb = Scan(uv,  0.0);
    float wc = Scan(uv,  1.0);
    return a * wa + b * wb + c * wc;
}

vec3 Bloom(vec2 uv)
{
    vec3 a  = Horz5(uv, -2.0);
    vec3 b  = Horz7(uv, -1.0);
    vec3 c  = Horz7(uv,  0.0);
    vec3 d  = Horz7(uv,  1.0);
    vec3 e  = Horz5(uv,  2.0);
    float wa = BloomScan(uv, -2.0);
    float wb = BloomScan(uv, -1.0);
    float wc = BloomScan(uv,  0.0);
    float wd = BloomScan(uv,  1.0);
    float we = BloomScan(uv,  2.0);
    return a * wa + b * wb + c * wc + d * wd + e * we;
}

vec3 Mask(vec2 fragCoord)
{
    vec3 mask = vec3(maskDark);
    fragCoord.x += fragCoord.y * 3.0;
    fragCoord.x  = fract(fragCoord.x * 0.166666666);
    if      (fragCoord.x < 0.333) mask.r = maskLight;
    else if (fragCoord.x < 0.666) mask.g = maskLight;
    else                          mask.b = maskLight;
    return mask;
}

void main()
{
    const ivec2 pix = ivec2(gl_GlobalInvocationID.x, gl_GlobalInvocationID.y);

    if (!effect_isPixValid(pix))
    {
        return;
    }

    vec2 uv = effect_getFramebufUV(pix);
    vec2 warped = Warp(uv);

    if (warped.x < 0.0 || warped.x > 1.0 || warped.y < 0.0 || warped.y > 1.0)
    {
        effect_storeToTarget(vec3(0.0), pix);
        return;
    }

    vec3 color = Tri(warped);
    color += Bloom(warped) * bloomAmount;
    color *= Mask(vec2(pix));
    effect_storeToTarget(ToSrgb(color), pix);
}
